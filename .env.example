# Business OS v3 — environment variables (udaharan)
#
# DATABASE_URL NA ho  → LOCAL mode: data isi computer ki SQLite file me
#                        (backend/data/business-os.db) — v2 wala behavior.
# DATABASE_URL ho     → CLOUD mode: saara data is PostgreSQL me jayega.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
#
# Server ka port. Local par aam taur par 4000; Render jaise host khud
# apna PORT dete hain (wahan ye set karne ki zarurat nahi).
PORT=4000
#
# ===== SaaS Stage 2 (OTP signup / subscription / super admin) =====
#
# Email OTP ke liye SMTP config. Ye paanchon set honge tabhi LIVE email
# jayega (signup OTP + password-reset OTP). Config NA ho to app dev mode
# me chalega: OTP email NAHI jayega, code sirf server console log me
# "[DEV-MAIL]" line me dikhega, aur API response me mail_configured:false
# aayega — kabhi OTP response me nahi aata.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-smtp-user
MAIL_PASS=your-smtp-password
MAIL_FROM=Business OS <no-reply@example.com>
# (SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM bhi chalenge —
#  MAIL_* pehle dekha jata hai.)
#
# DILIGENCE Super Admin login. Dono set hone par server boot par ye admin
# account ban/update ho jata hai; is email+password se normal login page
# se hi admin panel khulta hai. Password yahi env hai — badalna ho to env
# badal kar server restart karo.
SUPER_ADMIN_EMAIL=admin@thediligence.in
SUPER_ADMIN_PASSWORD=ek-mazboot-password-yahan
#
# Razorpay (online subscription payment). Founder ki apni keys aane par
# hi set karna — tab tak gateway endpoints 501 'gateway_not_configured'
# denge aur app me UPI/manual claim wala rasta chalega. Kabhi bhi koi
# nakli "payment success" nahi banta.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# ===== SaaS Stage 3 (Sync — Bharosa wala hisa) =====
#
# Ek LOCAL instance ko CLOUD (hub) instance se sync karne ke liye.
# Teeno set honge tabhi is instance par sync chalega; na ho to sync
# band rehta hai aur app akela chalta hai (cloud single-instance ko
# sync ki zarurat hi nahi). Hub wahi app hai — alag software nahi.
# SYNC_HUB_EMAIL/PASSWORD = dukaan ka apna HUB (cloud) account, jisse
# ye instance har sync par hub me login karke push/pull karta hai.
SYNC_HUB_URL=https://your-cloud-app.example.com
SYNC_HUB_EMAIL=owner@shop-email.com
SYNC_HUB_PASSWORD=<redacted>
